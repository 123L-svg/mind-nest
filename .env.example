# ===== 强制必填项（生产环境必须填写，无默认值，缺失将导致相关服务启动失败） =====

# MySQL root 密码（强随机，至少 16 位）
MYSQL_ROOT_PASSWORD=

# Redis 密码
REDIS_PASSWORD=

# RabbitMQ 账号密码（账号建议改为非 guest，guest 只能本机访问）
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# MinIO 管理员账号密码
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=

# JWT 签名密钥（强随机，至少 32 位，泄露则所有 token 可被伪造）
JWT_SECRET=

# CORS 白名单：生产必须填正式域名，多个用逗号分隔，例如 https://yourdomain.com
CORS_ALLOWED_ORIGINS=

# ===== AI（真实模型接入，ChatAnywhere）=====
# 填入你的 ChatAnywhere API Key 后，将 AI_MOCK_ENABLED 改为 false 走真实模型
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_MOCK_ENABLED=true

# ===== 可选配置项（有默认值，按需覆盖） =====

# Spring 激活的 profile，生产默认 prod
SPRING_PROFILES_ACTIVE=prod

# 搜索引擎：elasticsearch | mysql（生产无 ES 时用 mysql）
NOTE_SEARCH_ENGINE=mysql
ES_REINDEX_ON_START=false

# 回收站保留天数
NOTE_RECYCLE_KEEP_DAYS=30